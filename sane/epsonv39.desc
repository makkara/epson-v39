;
; SANE Backend specification file
;
; It's basically emacs-lisp --- so ";" indicates comment to end of line.
; All syntactic elements are keyword tokens, followed by a string or
;  keyword argument, as specified.
;

:backend "epsonv39"
:version "2"
:manpage "sane-epsonv39"
:comment "Free backend for Epson's host-based Perfection V39; needs Epson's firmware file esfw010c.bin, see the manpage"
:url "https://github.com/makkara/epson-v39"
:devicetype :scanner

:mfg "Epson"
:url "https://www.epson.com/"

:model "Perfection V39"
:interface "USB"
:usbid "0x04b8" "0x013d"
:status :good
:comment "Flatbed, 300-4800 dpi in hardware, lower resolutions in software. Colour, gray, lineart; four buttons. Needs firmware esfw010c.bin"

:model "GT-S650"
:interface "USB"
:usbid "0x04b8" "0x013d"
:status :good
:comment "Japanese name of the Perfection V39"

:model "Perfection V19"
:interface "USB"
:usbid "0x04b8" "0x013c"
:status :untested
:comment "Same firmware and Windows driver as the V39; enable it in epsonv39.conf"
